{
  "name": "tile-game",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "libs/*"
  ],
  "scripts": {
    "dev": "nx run-many -t serve --projects=api,web",
    "dev:api": "TS_NODE_PROJECT=apps/api/tsconfig.app.json ts-node -r tsconfig-paths/register apps/api/src/main.ts",
    "dev:web": "cd apps/web && next dev -p 3000",
    "build": "nx run-many -t build --all",
    "build:api:docker": "rm -rf dist/api-docker && tsc -p apps/api/tsconfig.app.json --outDir dist/api-docker && node tools/prepare-api-docker.mjs",
    "build:web:docker": "cd apps/web && next build",
    "test": "npm run test:shared && npm run test:api && npm run test:web",
    "test:shared": "vitest run -c libs/shared/vitest.config.ts",
    "test:api": "jest --config apps/api/jest.config.ts --runInBand",
    "test:web": "vitest run -c apps/web/vitest.config.ts",
    "lint": "eslint \"apps/api/**/*.ts\" \"apps/web/**/*.{ts,tsx}\" \"libs/shared/**/*.ts\"",
    "typecheck": "npm run typecheck:shared && npm run typecheck:api && npm run typecheck:web",
    "typecheck:shared": "tsc -p libs/shared/tsconfig.json --noEmit",
    "typecheck:api": "tsc -p apps/api/tsconfig.app.json --noEmit",
    "typecheck:web": "tsc -p apps/web/tsconfig.json --noEmit",
    "format": "nx format:write",
    "prepare": "husky"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.15",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.15",
    "@nestjs/mongoose": "^10.1.0",
    "@nestjs/platform-express": "^10.4.15",
    "@nestjs/swagger": "^7.4.2",
    "@nestjs/throttler": "^6.4.0",
    "axios": "^1.7.9",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "framer-motion": "^11.15.0",
    "mongoose": "^8.9.5",
    "next": "^14.2.23",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@nestjs/testing": "^10.4.15",
    "nx": "^19.8.14",
    "@nx/eslint": "^19.8.4",
    "@nx/jest": "^19.8.4",
    "@nx/js": "^19.8.4",
    "@nx/nest": "^19.8.4",
    "@nx/next": "^19.8.4",
    "@nx/vite": "^19.8.4",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^15.0.7",
    "@testing-library/user-event": "^14.5.2",
    "@types/jest": "^29.5.14",
    "@types/express": "^5.0.0",
    "@types/node": "^20.17.10",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/supertest": "^6.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.23",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "lint-staged": "^15.2.11",
    "postcss": "^8.4.49",
    "prettier": "^3.4.2",
    "supertest": "^7.0.0",
    "tailwindcss": "^3.4.17",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "@nx/eslint-plugin": "^19.8.4",
    "tslib": "^2.8.1",
    "typescript": "^5.3.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,json,md,css,yml,yaml}": "prettier --write"
  }
}
